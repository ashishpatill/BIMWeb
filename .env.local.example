# BIMWeb local development — copy to .env.local (setup-dev.sh does this automatically)
# Never commit .env.local; fill in real values from Kinde dashboard and your database provider.

# -----------------------------------------------------------------------------
# Database (Neon / Postgres)
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

# -----------------------------------------------------------------------------
# Kinde authentication (https://app.kinde.com)
# -----------------------------------------------------------------------------
KINDE_ISSUER_URL=https://your-subdomain.kinde.com
KINDE_CLIENT_ID=your_kinde_client_id
KINDE_CLIENT_SECRET=your_kinde_client_secret
KINDE_SITE_URL=http://localhost:3000
KINDE_POST_LOGOUT_REDIRECT_URL=http://localhost:3000
KINDE_POST_LOGIN_REDIRECT_URL=http://localhost:3000/dashboard

# -----------------------------------------------------------------------------
# Public API URLs (browser)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_BIMAGENT_URL=http://localhost:8000
NEXT_PUBLIC_BIMINDEX_URL=http://localhost:8001
NEXT_PUBLIC_BIMEXTRACT_URL=http://localhost:8200
NEXT_PUBLIC_BIMCLOUD_URL=http://localhost:8080
NEXT_PUBLIC_APP_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Server-side service URLs (SSR / API routes)
# -----------------------------------------------------------------------------
BIMAGENT_URL=http://127.0.0.1:8000
BIMINDEX_URL=http://127.0.0.1:8001
BIMEXTRACT_URL=http://127.0.0.1:8200
BIMCLOUD_URL=http://127.0.0.1:8080

# -----------------------------------------------------------------------------
# E2E / Playwright (dev and CI only — do not enable in production)
# -----------------------------------------------------------------------------
# E2E_TEST_BYPASS=true
E2E_TEST_USER_ID=kinde_test_user_id
E2E_TEST_USER_EMAIL=e2e-test@example.com
ECOSYSTEM_E2E=true

# -----------------------------------------------------------------------------
# Optional: Redis rate limiting (Upstash)
# -----------------------------------------------------------------------------
# UPSTASH_REDIS_REST_URL=https://your-upstash-url.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your_upstash_token

# -----------------------------------------------------------------------------
# Optional: transactional email (Resend)
# -----------------------------------------------------------------------------
# RESEND_API_KEY=re_xxxxxxxx
# EMAIL_FROM=BIMWeb <noreply@yourdomain.com>

# -----------------------------------------------------------------------------
# Optional: observability
# -----------------------------------------------------------------------------
# SENTRY_DSN=https://example@sentry.io/project
# NEXT_PUBLIC_SENTRY_DSN=https://example@sentry.io/project
# Analytics deferred — PostHog not wired in the app yet.
# When enabled, add NEXT_PUBLIC_POSTHOG_KEY and NEXT_PUBLIC_POSTHOG_HOST.

# -----------------------------------------------------------------------------
# Optional: file storage
# -----------------------------------------------------------------------------
STORAGE_BACKEND=local
