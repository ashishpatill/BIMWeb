# Placeholder env for Playwright E2E (public pages only).
# Copy to env.e2e or .env.e2e for local Playwright runs.

KINDE_CLIENT_ID=e2e_client_id
KINDE_CLIENT_SECRET=e2e_client_secret
KINDE_ISSUER_URL=https://example.kinde.com
KINDE_SITE_URL=http://localhost:3000
KINDE_POST_LOGOUT_REDIRECT_URL=http://localhost:3000
KINDE_POST_LOGIN_REDIRECT_URL=http://localhost:3000/dashboard

# Required by Drizzle — not hit during landing-page E2E
DATABASE_URL=postgresql://e2e:e2e@localhost:5432/e2e

# Ecosystem mocks (optional — start with ./start-platform.sh)
NEXT_PUBLIC_BIMAGENT_URL=http://localhost:8000
NEXT_PUBLIC_BIMINDEX_URL=http://localhost:8001
NEXT_PUBLIC_BIMEXTRACT_URL=http://localhost:8200
NEXT_PUBLIC_BIMCLOUD_URL=http://localhost:8080

# Upstash Redis (optional — rate limiter falls back to in-memory without these)
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
