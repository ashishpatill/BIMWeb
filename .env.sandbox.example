# BIMWeb — Sandbox / local development (Neon dev branch)
# Copy to .env.local and fill secrets from Neon console or Neon MCP get_connection_string.
# Never commit .env.local.

# Neon dev branch (sandbox)
DATABASE_URL=postgresql://USER:PASSWORD@ep-XXXX-pooler.c-9.us-east-1.aws.neon.tech/neondb?sslmode=require

# Kinde OAuth (sandbox app or dev redirect URLs)
KINDE_ISSUER_URL=https://your-subdomain.kinde.com
KINDE_CLIENT_ID=
KINDE_CLIENT_SECRET=
KINDE_SITE_URL=http://localhost:3000
KINDE_POST_LOGOUT_REDIRECT_URL=http://localhost:3000
KINDE_POST_LOGIN_REDIRECT_URL=http://localhost:3000/dashboard

# Backend URLs (local platform via ./start-platform.sh)
BIMAGENT_URL=http://localhost:8000
BIMINDEX_URL=http://localhost:8001
BIMEXTRACT_URL=http://localhost:8200
BIMCLOUD_URL=http://localhost:8080
NEXT_PUBLIC_BIMAGENT_URL=http://localhost:8000
NEXT_PUBLIC_BIMINDEX_URL=http://localhost:8001
NEXT_PUBLIC_BIMEXTRACT_URL=http://localhost:8200
NEXT_PUBLIC_BIMCLOUD_URL=http://localhost:8080
NEXT_PUBLIC_APP_URL=http://localhost:3000

# E2E / CI (optional)
E2E_TEST_BYPASS=false
E2E_TEST_USER_ID=

# Observability (optional)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# Email (optional)
RESEND_API_KEY=
EMAIL_FROM=

# Rate limiting / storage (optional)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
S3_BUCKET=
